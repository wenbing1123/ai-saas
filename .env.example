# ---------------------------------------------------------------------------
# Nebula API — AI token resale platform
# Copy to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nebula API
# Public origin customers point Claude Code / Codex / SDKs at (gateway base URL)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@nebulaapi.dev

# Logging (pino). Level: trace|debug|info|warn|error. Files: {LOG_DIR}/app.log,
# daily-rolled, 14 days kept. Dev also prints pretty lines to the console;
# production emits JSON to stdout as well (for docker/cloud log collectors).
LOG_LEVEL=info
LOG_DIR=logs

# AES-256-GCM key (64 hex chars) for encrypting stored API keys so users can
# re-view/copy them later and docs snippets can substitute the real key.
# Generate: openssl rand -hex 32
# When empty, API keys are hash-only and cannot be recovered after creation.
ENCRYPTION_KEY=

# PostgreSQL — source of truth (users, models, plans, orders, usage, ledger)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_saas
# Connection pool (postgres.js). Defaults shown.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT=30
PG_CONNECT_TIMEOUT=10
PG_MAX_LIFETIME=1800

# Redis — sessions, hot-path cache and rate limiting only (never the source of truth)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ai_saas:
# Login session lifetime in days (Redis TTL + cookie maxAge, renewed on activity). Default 7.
SESSION_TTL_DAYS=7
# Connection tunables (ioredis multiplexes commands over one socket —
# these control timeouts/reconnect, not pool size). Defaults shown; milliseconds.
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_KEEP_ALIVE=30000
# Per-command retry cap before failing. Set empty for null (unlimited, needed for blocking commands).
REDIS_MAX_RETRIES_PER_REQUEST=3

# Upstream provider credentials (server-side only; never exposed to the browser)
UPSTREAM_OPENAI_API_KEY=
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1

UPSTREAM_ANTHROPIC_API_KEY=
UPSTREAM_ANTHROPIC_BASE_URL=https://api.anthropic.com

UPSTREAM_GEMINI_API_KEY=
UPSTREAM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

UPSTREAM_DEEPSEEK_API_KEY=
UPSTREAM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Stripe (wire webhook → markOrderPaid; sandbox checkout works without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (activation/password-reset emails; leave SMTP_HOST empty for dev log mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nebula API <no-reply@example.com>

# OAuth sign-in (buttons appear only for providers with both ID+SECRET set).
# Google: https://console.cloud.google.com/apis/credentials → OAuth client (Web)
#   Redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers → OAuth App
#   Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Egress proxy for ALL outbound fetch (OAuth IdPs, Stripe, …). Standard vars —
# npm scripts enable NODE_USE_ENV_PROXY=1 so global fetch honors them.
# Leave empty in production when the server reaches these hosts directly.
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1
