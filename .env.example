# ---------------------------------------------------------------------------
# Nebula API — AI token resale platform
# Copy to .env.local and fill in real values.
# ---------------------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nebula API
# Public origin customers point Claude Code / Codex / SDKs at (gateway base URL)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@nebulaapi.dev

# PostgreSQL — source of truth (users, models, plans, orders, usage, ledger)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_saas

# Redis — sessions, hot-path cache and rate limiting only (never the source of truth)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ai_saas:

# Upstream provider credentials (server-side only; never exposed to the browser)
UPSTREAM_OPENAI_API_KEY=
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1

UPSTREAM_ANTHROPIC_API_KEY=
UPSTREAM_ANTHROPIC_BASE_URL=https://api.anthropic.com

UPSTREAM_GEMINI_API_KEY=
UPSTREAM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

UPSTREAM_DEEPSEEK_API_KEY=
UPSTREAM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Stripe (wire webhook → markOrderPaid; sandbox checkout works without it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
